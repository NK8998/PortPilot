{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/winport/winport/contracts/runtime.schema.json",
  "title": "PortPilot Runtime Evidence",
  "description": "Emitted by port-migration. Proof that the ported binary actually RUNS and behaves correctly, as opposed to merely compiling. A port that builds but was never executed is unproven; this contract is where that distinction is forced into the open, per architecture.",
  "type": "object",
  "required": ["schemaVersion", "target", "x64", "arm64"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "target": {
      "type": "object",
      "required": ["repo", "commit"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "path": { "type": "string" }
      }
    },
    "runtimeTree": {
      "type": "string",
      "description": "Fixture directory the smoke checks ran against, so a reviewer can recreate the conditions."
    },
    "x64": {
      "type": "array",
      "description": "Smoke checks executed on Windows x64. Must include at least one check that exercises ported behaviour, not just --version.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "arm64": {
      "description": "Either the executed Arm64 smoke checks, or an explicit statement that none ran. Never omit - absence of evidence must be stated, not implied.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        },
        {
          "type": "object",
          "required": ["executed", "reason"],
          "additionalProperties": false,
          "properties": {
            "executed": { "type": "boolean", "const": false },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "exitCode",
          "expectedResult",
          "observedResult",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^SCN-[0-9]{3}$" },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "expectedResult": { "type": "string", "minLength": 1 },
          "observedResult": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "command", "exitCode"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "command": { "type": "string" },
        "cwd": { "type": "string" },
        "exitCode": { "type": "integer" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "expectation": {
          "type": "string",
          "description": "What this check proves about the port. A check whose meaning is not stated is decoration."
        },
        "timestamp": { "type": "string" }
      }
    }
  }
}
