+/* ------------------------------------------------------------------ *
+ * Process control
+ *
+ * There is no fork() on Windows and no way to emulate one, so nnn's
+ * fork/exec/wait triad is replaced wholesale by CreateProcessW.
+ * ------------------------------------------------------------------ */
+
+/* Run argv to completion, or detached when nowait. Returns the child's
+ * exit status, or -1 on failure. */
+int win_spawn_argv(char *const argv[], int nowait, int notrace, int nostdin, int tty);
+
+/* Run argv to completion with stdout (and stderr) redirected to out_fd,
+ * then wait. This replaces the pipe()/fork()/dup2()/execvp()/waitpid()
+ * sequence nnn uses to capture command output; Windows has no fork(), so
+ * the redirection must be set up before the process is created rather
+ * than in a forked child. Returns the exit status, or -1 on failure. */
+int win_spawn_capture(char *const argv[], int out_fd);
+
+/* Anonymous pipe with a 64KB buffer, matching the default Linux pipe
+ * capacity. Not inheritable: win_spawn_capture() duplicates just the
+ * write end into the child, so the read end is never held open by it. */
+int win_pipe(int fds[2]);
