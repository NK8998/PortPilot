+/* ------------------------------------------------------------------ *
+ * Signals
+ *
+ * The CRT has ANSI signal() only: no sigaction, and none of
+ * SIGWINCH/SIGTSTP/SIGHUP/SIGQUIT/SIGPIPE. nnn already handles terminal
+ * resize through curses KEY_RESIZE (11 call sites), so SIGWINCH is not
+ * load-bearing here.
+ * ------------------------------------------------------------------ */
+
+#ifndef SIGHUP
+#define SIGHUP   1
+#endif
+#ifndef SIGQUIT
+#define SIGQUIT  3
+#endif
+#ifndef SIGPIPE
+#define SIGPIPE 13
+#endif
+#ifndef SIGTSTP
+#define SIGTSTP 20
+#endif
+#ifndef SIGWINCH
+#define SIGWINCH 28
+#endif
+
+struct sigaction {
+	void (*sa_handler)(int);
+	int    sa_mask;
+	int    sa_flags;
+};
+
+int win_sigaction(int sig, const struct sigaction *act, struct sigaction *old);
+/* Function-like, so `struct sigaction` is never expanded. */
+#define sigaction(s, a, o) win_sigaction((s), (a), (o))
