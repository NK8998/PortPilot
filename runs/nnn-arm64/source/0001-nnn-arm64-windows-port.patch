@@ -0,0 +1,1406 @@
+/*
+ * win_compat.c — Win32 portability layer for nnn
+ *
+ * Implementation of the POSIX surface declared in win_compat.h.
+ * See that header for the design rules.
+ */
+
+#ifdef _WIN32
+
+#include "win_compat.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <ctype.h>
+#include <time.h>
+#include <signal.h>
+
+/* ================================================================== *
+ * UTF-8 <-> UTF-16
+ *
+ * Every Windows API used here is the wide variant, so that paths with
+ * non-ASCII characters work regardless of the system code page.
+ * ================================================================== */
+
+wchar_t *win_utf8_to_wide(const char *s)
+{
+	if (!s)
+		return NULL;
+
+	int need = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);
+
+	if (need <= 0)
+		return NULL;
+
+	wchar_t *w = (wchar_t *)malloc((size_t)need * sizeof(wchar_t));
+
+	if (!w)
+		return NULL;
+
+	if (MultiByteToWideChar(CP_UTF8, 0, s, -1, w, need) <= 0) {
+		free(w);
+		return NULL;
+	}
+	return w;
+}
+
+char *win_wide_to_utf8(const wchar_t *w)
+{
+	if (!w)
+		return NULL;
+
+	int need = WideCharToMultiByte(CP_UTF8, 0, w, -1, NULL, 0, NULL, NULL);
+
+	if (need <= 0)
+		return NULL;
+
+	char *s = (char *)malloc((size_t)need);
+
+	if (!s)
+		return NULL;
+
+	if (WideCharToMultiByte(CP_UTF8, 0, w, -1, s, need, NULL, NULL) <= 0) {
+		free(s);
+		return NULL;
+	}
+	return s;
+}
+
+/* Convert a UTF-8 path to UTF-16, normalising '/' to '\'. */
+static wchar_t *path_to_wide(const char *path)
+{
+	wchar_t *w = win_utf8_to_wide(path);
+
+	if (!w)
+		return NULL;
+
+	for (wchar_t *p = w; *p; ++p)
+		if (*p == L'/')
+			*p = L'\\';
+
+	return w;
+}
+
+/* ================================================================== *
+ * stat family
+ * ================================================================== */
+
+static time_t filetime_to_time_t(const FILETIME *ft)
+{
+	ULARGE_INTEGER u;
+
+	u.LowPart = ft->dwLowDateTime;
+	u.HighPart = ft->dwHighDateTime;
+
+	/* 100ns ticks since 1601-01-01 -> seconds since 1970-01-01 */
+	return (time_t)((u.QuadPart / 10000000ULL) - 11644473600ULL);
+}
+
+/* Sub-second remainder of the same tick count, in nanoseconds. */
+static uint32_t filetime_to_nsec(const FILETIME *ft)
+{
+	ULARGE_INTEGER u;
+
+	u.LowPart = ft->dwLowDateTime;
+	u.HighPart = ft->dwHighDateTime;
+
+	return (uint32_t)((u.QuadPart % 10000000ULL) * 100ULL);
+}
+
+static uint32_t attrs_to_mode(DWORD attrs, const wchar_t *wpath)
+{
+	uint32_t mode;
+
+	if (attrs & FILE_ATTRIBUTE_REPARSE_POINT)
+		mode = S_IFLNK;
+	else if (attrs & FILE_ATTRIBUTE_DIRECTORY)
+		mode = _S_IFDIR;
+	else
+		mode = _S_IFREG;
+
+	/* Windows has no POSIX permission model. Report a sensible
+	 * approximation: readable always, writable unless the read-only
+	 * attribute is set, executable for directories and by extension. */
+	mode |= 0444;
+
+	if (!(attrs & FILE_ATTRIBUTE_READONLY))
+		mode |= 0222;
+
+	if (attrs & FILE_ATTRIBUTE_DIRECTORY) {
+		mode |= 0111;
+	} else if (wpath) {
+		const wchar_t *dot = wcsrchr(wpath, L'.');
+
+		if (dot && (!_wcsicmp(dot, L".exe") || !_wcsicmp(dot, L".com")
+			    || !_wcsicmp(dot, L".bat") || !_wcsicmp(dot, L".cmd")))
+			mode |= 0111;
+	}
+
+	return mode;
+}
+
+/* Fill a struct win_stat from an open handle, which is the only way to
+ * obtain a stable file index (the Windows equivalent of st_ino) and the
+ * on-disk allocation size (st_blocks). */
+static int stat_from_handle(HANDLE h, const wchar_t *wpath, struct win_stat *sb)
+{
+	BY_HANDLE_FILE_INFORMATION bhfi;
+
+	if (!GetFileInformationByHandle(h, &bhfi))
+		return -1;
+
+	memset(sb, 0, sizeof(*sb));
+
+	sb->st_dev = bhfi.dwVolumeSerialNumber;
+	sb->st_ino = ((uint64_t)bhfi.nFileIndexHigh << 32) | bhfi.nFileIndexLow;
+	sb->st_mode = attrs_to_mode(bhfi.dwFileAttributes, wpath);
+	sb->st_nlink = bhfi.nNumberOfLinks;
+	sb->st_size = ((int64_t)bhfi.nFileSizeHigh << 32) | bhfi.nFileSizeLow;
+	sb->st_atime = filetime_to_time_t(&bhfi.ftLastAccessTime);
+	sb->st_mtime = filetime_to_time_t(&bhfi.ftLastWriteTime);
+	sb->st_ctime = filetime_to_time_t(&bhfi.ftCreationTime);
+	sb->st_atime_nsec = filetime_to_nsec(&bhfi.ftLastAccessTime);
+	sb->st_mtime_nsec = filetime_to_nsec(&bhfi.ftLastWriteTime);
+	sb->st_ctime_nsec = filetime_to_nsec(&bhfi.ftCreationTime);
+	sb->st_blksize = 4096;
+
+	/* Real allocated size, so that nnn's disk-usage mode reports what
+	 * the filesystem actually consumes rather than the apparent size. */
+	FILE_STANDARD_INFO fsi;
+
+	if (GetFileInformationByHandleEx(h, FileStandardInfo, &fsi, sizeof(fsi)))
+		sb->st_blocks = (blkcnt_t)(fsi.AllocationSize.QuadPart / S_BLKSIZE);
+	else
+		sb->st_blocks = (blkcnt_t)((sb->st_size + S_BLKSIZE - 1) / S_BLKSIZE);
+
+	return 0;
+}
+
+static int do_stat(const char *path, struct win_stat *sb, int nofollow)
+{
+	if (!path || !sb) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	wchar_t *wpath = path_to_wide(path);
+
+	if (!wpath) {
+		errno = ENOMEM;
+		return -1;
+	}
+
+	DWORD flags = FILE_FLAG_BACKUP_SEMANTICS;   /* required to open directories */
+
+	if (nofollow)
+		flags |= FILE_FLAG_OPEN_REPARSE_POINT;
+
+	HANDLE h = CreateFileW(wpath, FILE_READ_ATTRIBUTES,
+			       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+			       NULL, OPEN_EXISTING, flags, NULL);
+
+	if (h == INVALID_HANDLE_VALUE) {
+		/* Fall back to the attribute-only query, which succeeds for
+		 * files we may not open (e.g. in-use system files). */
+		WIN32_FILE_ATTRIBUTE_DATA fad;
+
+		if (GetFileAttributesExW(wpath, GetFileExInfoStandard, &fad)) {
+			memset(sb, 0, sizeof(*sb));
+			sb->st_mode = attrs_to_mode(fad.dwFileAttributes, wpath);
+			sb->st_nlink = 1;
+			sb->st_size = ((int64_t)fad.nFileSizeHigh << 32) | fad.nFileSizeLow;
+			sb->st_atime = filetime_to_time_t(&fad.ftLastAccessTime);
+			sb->st_mtime = filetime_to_time_t(&fad.ftLastWriteTime);
+			sb->st_ctime = filetime_to_time_t(&fad.ftCreationTime);
+			sb->st_atime_nsec = filetime_to_nsec(&fad.ftLastAccessTime);
+			sb->st_mtime_nsec = filetime_to_nsec(&fad.ftLastWriteTime);
+			sb->st_ctime_nsec = filetime_to_nsec(&fad.ftCreationTime);
+			sb->st_blksize = 4096;
+			sb->st_blocks = (blkcnt_t)((sb->st_size + S_BLKSIZE - 1) / S_BLKSIZE);
+			free(wpath);
+			return 0;
+		}
+
+		free(wpath);
+		errno = ENOENT;
+		return -1;
+	}
+
+	int r = stat_from_handle(h, wpath, sb);
+
+	CloseHandle(h);
+	free(wpath);
+
+	if (r != 0)
+		errno = EIO;
+
+	return r;
+}
+
+int win_stat(const char *path, struct win_stat *sb)
+{
+	return do_stat(path, sb, 0);
+}
+
+int win_lstat(const char *path, struct win_stat *sb)
+{
+	return do_stat(path, sb, 1);
+}
+
+int win_fstat_fd(int fd, struct win_stat *sb)
+{
+	HANDLE h = (HANDLE)_get_osfhandle(fd);
+
+	if (h == INVALID_HANDLE_VALUE || !sb) {
+		errno = EBADF;
+		return -1;
+	}
+	return stat_from_handle(h, NULL, sb);
+}
+
+int win_fstatat(int dirfd, const char *path, struct win_stat *sb, int flags)
+{
+	(void)dirfd;   /* nnn only ever performs CWD-relative lookups */
+	return do_stat(path, sb, (flags & AT_SYMLINK_NOFOLLOW) ? 1 : 0);
+}
+
+/* ================================================================== *
+ * dirent over FindFirstFileW
+ *
+ * Using the Find* API rather than the CRT's opendir gives us d_type for
+ * free, avoiding a stat() per entry.
+ * ================================================================== */
+
+struct win_DIR {
+	HANDLE           h;
+	WIN32_FIND_DATAW fd;
+	int              first;
+	struct dirent    ent;
+};
+
+DIR *opendir(const char *path)
+{
+	if (!path) {
+		errno = EINVAL;
+		return NULL;
+	}
+
+	size_t len = strlen(path);
+	char  *pat = (char *)malloc(len + 3);
+
+	if (!pat) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	memcpy(pat, path, len);
+
+	/* Append the wildcard, inserting a separator only if needed. */
+	if (len && (path[len - 1] == '\\' || path[len - 1] == '/'))
+		strcpy(pat + len, "*");
+	else
+		strcpy(pat + len, "\\*");
+
+	wchar_t *wpat = path_to_wide(pat);
+
+	free(pat);
+
+	if (!wpat) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	DIR *d = (DIR *)calloc(1, sizeof(DIR));
+
+	if (!d) {
+		free(wpat);
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	d->h = FindFirstFileExW(wpat, FindExInfoBasic, &d->fd,
+				FindExSearchNameMatch, NULL, 0);
+	free(wpat);
+
+	if (d->h == INVALID_HANDLE_VALUE) {
+		free(d);
+		errno = ENOENT;
+		return NULL;
+	}
+
+	d->first = 1;
+	return d;
+}
+
+struct dirent *readdir(DIR *d)
+{
+	if (!d) {
+		errno = EINVAL;
+		return NULL;
+	}
+
+	for (;;) {
+		if (d->first) {
+			d->first = 0;
+		} else if (!FindNextFileW(d->h, &d->fd)) {
+			return NULL;
+		}
+
+		/* nnn filters "." and ".." itself, but the Win32 API also
+		 * returns them; skipping here keeps behaviour identical to
+		 * a POSIX readdir on a filesystem that omits them. */
+		const wchar_t *n = d->fd.cFileName;
+
+		if (n[0] == L'.' && (n[1] == L'\0' || (n[1] == L'.' && n[2] == L'\0')))
+			continue;
+
+		char *utf8 = win_wide_to_utf8(n);
+
+		if (!utf8)
+			continue;
+
+		size_t l = strlen(utf8);
+
+		if (l >= sizeof(d->ent.d_name))
+			l = sizeof(d->ent.d_name) - 1;
+
+		memcpy(d->ent.d_name, utf8, l);
+		d->ent.d_name[l] = '\0';
+		free(utf8);
+
+		DWORD a = d->fd.dwFileAttributes;
+
+		if (a & FILE_ATTRIBUTE_REPARSE_POINT)
+			d->ent.d_type = DT_LNK;
+		else if (a & FILE_ATTRIBUTE_DIRECTORY)
+			d->ent.d_type = DT_DIR;
+		else
+			d->ent.d_type = DT_REG;
+
+		d->ent.d_ino = 0;
+		d->ent.d_reclen = (unsigned short)sizeof(struct dirent);
+
+		return &d->ent;
+	}
+}
+
+int closedir(DIR *d)
+{
+	if (!d) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (d->h != INVALID_HANDLE_VALUE)
+		FindClose(d->h);
+
+	free(d);
+	return 0;
+}
+
+int dirfd(DIR *d)
+{
+	/* Windows has no directory file descriptor. nnn uses the result
+	 * only for *at() calls, which we resolve against the CWD. */
+	(void)d;
+	return AT_FDCWD;
+}
+
+/* ================================================================== *
+ * statvfs
+ * ================================================================== */
+
+int statvfs(const char *path, struct statvfs *buf)
+{
+	if (!path || !buf) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	wchar_t *wpath = path_to_wide(path);
+
+	if (!wpath) {
+		errno = ENOMEM;
+		return -1;
+	}
+
+	ULARGE_INTEGER avail, total, free_bytes;
+	BOOL ok = GetDiskFreeSpaceExW(wpath, &avail, &total, &free_bytes);
+
+	free(wpath);
+
+	if (!ok) {
+		errno = ENOENT;
+		return -1;
+	}
+
+	memset(buf, 0, sizeof(*buf));
+
+	/* Report in 1-byte units so that block * size arithmetic in nnn
+	 * yields the correct byte counts without a scaling factor. */
+	buf->f_bsize = 1;
+	buf->f_frsize = 1;
+	buf->f_blocks = total.QuadPart;
+	buf->f_bfree = free_bytes.QuadPart;
+	buf->f_bavail = avail.QuadPart;
+	buf->f_namemax = 255;
+
+	return 0;
+}
+
+/* ================================================================== *
+ * Signals
+ *
+ * Only SIGINT has a real Windows analogue (Ctrl+C / Ctrl+Break). The
+ * rest are accepted and ignored so that nnn's setup code runs
+ * unmodified.
+ * ================================================================== */
+
+static void (*g_sigint_handler)(int);
+
+static BOOL WINAPI console_ctrl_handler(DWORD type)
+{
+	if ((type == CTRL_C_EVENT || type == CTRL_BREAK_EVENT) && g_sigint_handler) {
+		g_sigint_handler(SIGINT);
+		return TRUE;
+	}
+	return FALSE;
+}
+
+int win_sigaction(int sig, const struct sigaction *act, struct sigaction *old)
+{
+	/* Wide enough for both the CRT's signal numbers and the POSIX ones
+	 * we synthesise above (the largest being SIGWINCH at 28). */
+	static struct sigaction saved[32];
+	static int installed;
+
+	if (sig < 0 || sig >= (int)(sizeof(saved) / sizeof(saved[0]))) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (old)
+		*old = saved[sig];
+
+	if (!act)
+		return 0;
+
+	saved[sig] = *act;
+
+	if (sig == SIGINT) {
+		g_sigint_handler = act->sa_handler;
+
+		if (!installed) {
+			SetConsoleCtrlHandler(console_ctrl_handler, TRUE);
+			installed = 1;
+		}
+	}
+
+	/* SIGHUP, SIGQUIT, SIGPIPE, SIGTSTP and SIGWINCH have no Windows
+	 * equivalent. SIGWINCH in particular is unnecessary because nnn
+	 * already handles resize via curses KEY_RESIZE. */
+	return 0;
+}
+
+/* ================================================================== *
+ * Process spawning
+ *
+ * fork() cannot be emulated on Windows, so nnn's fork/exec/wait triad
+ * is replaced by CreateProcessW with explicit handle redirection.
+ * ================================================================== */
+
+/* Quote one argv element per the CommandLineToArgvW rules, appending to
+ * *dst. Returns the new end pointer, or NULL on overflow. */
+static wchar_t *append_quoted(wchar_t *dst, const wchar_t *end, const wchar_t *arg)
+{
+	int needs_quote = (*arg == L'\0');
+
+	for (const wchar_t *p = arg; *p && !needs_quote; ++p)
+		if (*p == L' ' || *p == L'\t' || *p == L'"')
+			needs_quote = 1;
+
+	if (!needs_quote) {
+		size_t l = wcslen(arg);
+
+		if (dst + l >= end)
+			return NULL;
+
+		wmemcpy(dst, arg, l);
+		return dst + l;
+	}
+
+	if (dst >= end)
+		return NULL;
+	*dst++ = L'"';
+
+	for (const wchar_t *p = arg; *p; ++p) {
+		size_t slashes = 0;
+
+		while (*p == L'\\') {
+			++slashes;
+			++p;
+		}
+
+		if (*p == L'\0') {
+			/* Trailing backslashes must be doubled so they do
+			 * not escape the closing quote. */
+			if (dst + slashes * 2 >= end)
+				return NULL;
+			for (size_t i = 0; i < slashes * 2; ++i)
+				*dst++ = L'\\';
+			break;
+		}
+
+		if (*p == L'"') {
+			if (dst + slashes * 2 + 2 >= end)
+				return NULL;
+			for (size_t i = 0; i < slashes * 2; ++i)
+				*dst++ = L'\\';
+			*dst++ = L'\\';
+			*dst++ = L'"';
+		} else {
+			if (dst + slashes + 1 >= end)
+				return NULL;
+			for (size_t i = 0; i < slashes; ++i)
+				*dst++ = L'\\';
+			*dst++ = *p;
+		}
+	}
+
+	if (dst >= end)
+		return NULL;
+	*dst++ = L'"';
+
+	return dst;
+}
+
+/* Build a CreateProcessW command line from a POSIX argv, applying the
+ * CommandLineToArgvW quoting rules. Caller frees. */
+static wchar_t *build_cmdline(char *const argv[])
+{
+	size_t   cap = 32768;
+	wchar_t *cmdline = (wchar_t *)malloc(cap * sizeof(wchar_t));
+
+	if (!cmdline) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	wchar_t *dst = cmdline;
+	wchar_t *end = cmdline + cap - 1;
+
+	for (int i = 0; argv[i]; ++i) {
+		if (i) {
+			if (dst >= end) {
+				free(cmdline);
+				errno = E2BIG;
+				return NULL;
+			}
+			*dst++ = L' ';
+		}
+
+		wchar_t *warg = win_utf8_to_wide(argv[i]);
+
+		if (!warg) {
+			free(cmdline);
+			errno = ENOMEM;
+			return NULL;
+		}
+
+		wchar_t *n = append_quoted(dst, end, warg);
+
+		free(warg);
+
+		if (!n) {
+			free(cmdline);
+			errno = E2BIG;
+			return NULL;
+		}
+		dst = n;
+	}
+	*dst = L'\0';
+
+	return cmdline;
+}
+
+int win_spawn_argv(char *const argv[], int nowait, int notrace, int nostdin, int tty)
+{
+	if (!argv || !argv[0]) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	(void)tty;   /* the child inherits our console, which is already a tty */
+
+	wchar_t *cmdline = build_cmdline(argv);
+
+	if (!cmdline)
+		return -1;
+
+	STARTUPINFOW si;
+	PROCESS_INFORMATION pi;
+
+	memset(&si, 0, sizeof(si));
+	memset(&pi, 0, sizeof(pi));
+	si.cb = sizeof(si);
+
+	HANDLE hnull = INVALID_HANDLE_VALUE;
+
+	if (notrace) {
+		SECURITY_ATTRIBUTES sa;
+
+		sa.nLength = sizeof(sa);
+		sa.lpSecurityDescriptor = NULL;
+		sa.bInheritHandle = TRUE;
+
+		hnull = CreateFileW(L"NUL", GENERIC_READ | GENERIC_WRITE,
+				    FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+				    OPEN_EXISTING, 0, NULL);
+
+		if (hnull != INVALID_HANDLE_VALUE) {
+			si.dwFlags |= STARTF_USESTDHANDLES;
+			si.hStdInput = nostdin ? hnull
+					       : GetStdHandle(STD_INPUT_HANDLE);
+			si.hStdOutput = hnull;
+			si.hStdError = hnull;
+		}
+	}
+
+	DWORD flags = 0;
+
+	if (nowait)
+		flags |= DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP;
+
+	BOOL ok = CreateProcessW(NULL, cmdline, NULL, NULL, TRUE, flags,
+				 NULL, NULL, &si, &pi);
+
+	free(cmdline);
+
+	if (hnull != INVALID_HANDLE_VALUE)
+		CloseHandle(hnull);
+
+	if (!ok) {
+		errno = ENOENT;
+		return -1;
+	}
+
+	CloseHandle(pi.hThread);
+
+	if (nowait) {
+		CloseHandle(pi.hProcess);
+		return 0;
+	}
+
+	WaitForSingleObject(pi.hProcess, INFINITE);
+
+	DWORD code = 0;
+
+	GetExitCodeProcess(pi.hProcess, &code);
+	CloseHandle(pi.hProcess);
+
+	return (int)code;
+}
+
+int win_spawn_capture(char *const argv[], int out_fd)
+{	if (!argv || !argv[0]) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	HANDLE hout = (HANDLE)_get_osfhandle(out_fd);
+
+	if (hout == INVALID_HANDLE_VALUE) {
+		errno = EBADF;
+		return -1;
+	}
+
+	/* The child only inherits handles explicitly marked inheritable. */
+	HANDLE hinherit = INVALID_HANDLE_VALUE;
+
+	if (!DuplicateHandle(GetCurrentProcess(), hout,
+			     GetCurrentProcess(), &hinherit,
+			     0, TRUE, DUPLICATE_SAME_ACCESS)) {
+		errno = EBADF;
+		return -1;
+	}
+
+	wchar_t *cmdline = build_cmdline(argv);
+
+	if (!cmdline) {
+		CloseHandle(hinherit);
+		return -1;
+	}
+
+	STARTUPINFOW si;
+	PROCESS_INFORMATION pi;
+
+	memset(&si, 0, sizeof(si));
+	memset(&pi, 0, sizeof(pi));
+	si.cb = sizeof(si);
+	si.dwFlags = STARTF_USESTDHANDLES;
+	si.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+	si.hStdOutput = hinherit;
+	si.hStdError = hinherit;
+
+	BOOL ok = CreateProcessW(NULL, cmdline, NULL, NULL, TRUE, 0,
+				 NULL, NULL, &si, &pi);
+
+	free(cmdline);
+	CloseHandle(hinherit);
+
+	if (!ok) {
+		errno = ENOENT;
+		return -1;
+	}
+
+	CloseHandle(pi.hThread);
+	WaitForSingleObject(pi.hProcess, INFINITE);
+
+	DWORD code = 0;
+
+	GetExitCodeProcess(pi.hProcess, &code);
+	CloseHandle(pi.hProcess);
+
+	return (int)code;
+}
+
+int win_pipe(int fds[2])
+{
+	if (!fds) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	return _pipe(fds, 65536, _O_BINARY | _O_NOINHERIT);
+}
+
+/* ================================================================== *
+ * Environment
+ * ================================================================== */
+int win_setenv(const char *name, const char *value, int overwrite)
+{
+	if (!name || !*name || strchr(name, '=')) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (!overwrite && getenv(name))
+		return 0;
+
+	return _putenv_s(name, value ? value : "") == 0 ? 0 : -1;
+}
+
+int win_unsetenv(const char *name)
+{
+	if (!name || !*name || strchr(name, '=')) {
+		errno = EINVAL;
+		return -1;
+	}
+	return _putenv_s(name, "") == 0 ? 0 : -1;
+}
+
+/* ================================================================== *
+ * Paths and links
+ * ================================================================== */
+
+char *win_realpath(const char *path, char *resolved)
+{
+	if (!path) {
+		errno = EINVAL;
+		return NULL;
+	}
+
+	wchar_t *wpath = path_to_wide(path);
+
+	if (!wpath) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	/* Open the file so that reparse points are resolved, which
+	 * _fullpath() does not do. */
+	HANDLE h = CreateFileW(wpath, FILE_READ_ATTRIBUTES,
+			       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+			       NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+
+	wchar_t  wbuf[PATH_MAX];
+	wchar_t *wfinal = NULL;
+
+	if (h != INVALID_HANDLE_VALUE) {
+		DWORD n = GetFinalPathNameByHandleW(h, wbuf, PATH_MAX,
+						    FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+
+		CloseHandle(h);
+
+		if (n > 0 && n < PATH_MAX) {
+			wfinal = wbuf;
+
+			/* Strip the \\?\ prefix that GetFinalPathName adds. */
+			if (!wcsncmp(wfinal, L"\\\\?\\", 4))
+				wfinal += 4;
+		}
+	}
+
+	if (!wfinal) {
+		DWORD n = GetFullPathNameW(wpath, PATH_MAX, wbuf, NULL);
+
+		if (n == 0 || n >= PATH_MAX) {
+			free(wpath);
+			errno = ENOENT;
+			return NULL;
+		}
+		wfinal = wbuf;
+	}
+
+	free(wpath);
+
+	char *utf8 = win_wide_to_utf8(wfinal);
+
+	if (!utf8) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	if (!resolved)
+		return utf8;   /* GNU allocating form, as nnn uses */
+
+	size_t l = strlen(utf8);
+
+	if (l >= PATH_MAX) {
+		free(utf8);
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+
+	memcpy(resolved, utf8, l + 1);
+	free(utf8);
+
+	return resolved;
+}
+
+ssize_t win_readlink(const char *path, char *buf, size_t bufsiz)
+{
+	if (!path || !buf) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	wchar_t *wpath = path_to_wide(path);
+
+	if (!wpath) {
+		errno = ENOMEM;
+		return -1;
+	}
+
+	HANDLE h = CreateFileW(wpath, FILE_READ_ATTRIBUTES,
+			       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+			       NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+
+	free(wpath);
+
+	if (h == INVALID_HANDLE_VALUE) {
+		errno = ENOENT;
+		return -1;
+	}
+
+	wchar_t wbuf[PATH_MAX];
+	DWORD   n = GetFinalPathNameByHandleW(h, wbuf, PATH_MAX,
+					      FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);
+
+	CloseHandle(h);
+
+	if (n == 0 || n >= PATH_MAX) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	wchar_t *w = wbuf;
+
+	if (!wcsncmp(w, L"\\\\?\\", 4))
+		w += 4;
+
+	char *utf8 = win_wide_to_utf8(w);
+
+	if (!utf8) {
+		errno = ENOMEM;
+		return -1;
+	}
+
+	size_t l = strlen(utf8);
+
+	if (l > bufsiz)
+		l = bufsiz;
+
+	memcpy(buf, utf8, l);   /* readlink() does not NUL-terminate */
+	free(utf8);
+
+	return (ssize_t)l;
+}
+
+int win_symlink(const char *target, const char *linkpath)
+{
+	if (!target || !linkpath) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	wchar_t *wt = path_to_wide(target);
+	wchar_t *wl = path_to_wide(linkpath);
+
+	if (!wt || !wl) {
+		free(wt);
+		free(wl);
+		errno = ENOMEM;
+		return -1;
+	}
+
+	DWORD flags = 0;
+	DWORD attrs = GetFileAttributesW(wt);
+
+	if (attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY))
+		flags |= SYMBOLIC_LINK_FLAG_DIRECTORY;
+
+	/* Without Developer Mode, creating a symlink needs elevation. */
+	flags |= SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE;
+
+	BOOL ok = CreateSymbolicLinkW(wl, wt, flags);
+
+	free(wt);
+	free(wl);
+
+	if (!ok) {
+		errno = EPERM;
+		return -1;
+	}
+	return 0;
+}
+
+/* ================================================================== *
+ * String helpers absent from the CRT
+ * ================================================================== */
+
+char *win_strsep(char **stringp, const char *delim)
+{
+	char *s = *stringp;
+
+	if (!s)
+		return NULL;
+
+	for (char *p = s; *p; ++p) {
+		if (strchr(delim, *p)) {
+			*p = '\0';
+			*stringp = p + 1;
+			return s;
+		}
+	}
+
+	*stringp = NULL;
+	return s;
+}
+
+char *win_strcasestr(const char *haystack, const char *needle)
+{
+	if (!haystack || !needle)
+		return NULL;
+
+	if (!*needle)
+		return (char *)haystack;
+
+	size_t nl = strlen(needle);
+
+	for (const char *p = haystack; *p; ++p)
+		if (!_strnicmp(p, needle, nl))
+			return (char *)p;
+
+	return NULL;
+}
+
+/* ================================================================== *
+ * Character width
+ *
+ * The UCRT has no wcwidth(). This implements the Unicode East Asian
+ * Wide/Fullwidth and zero-width rules, which is what nnn needs to align
+ * columns correctly.
+ * ================================================================== */
+
+static int is_zero_width(wchar_t wc)
+{
+	return (wc >= 0x0300 && wc <= 0x036F)     /* combining diacriticals */
+	    || (wc >= 0x200B && wc <= 0x200F)     /* zero-width / direction  */
+	    || (wc >= 0xFE00 && wc <= 0xFE0F)     /* variation selectors     */
+	    || (wc >= 0xFE20 && wc <= 0xFE2F)     /* combining half marks    */
+	    || wc == 0x00AD;                      /* soft hyphen             */
+}
+
+static int is_wide(wchar_t wc)
+{
+	return (wc >= 0x1100 && wc <= 0x115F)     /* Hangul Jamo             */
+	    || (wc >= 0x2E80 && wc <= 0x303E)     /* CJK radicals, Kangxi    */
+	    || (wc >= 0x3041 && wc <= 0x33FF)     /* Hiragana .. CJK compat  */
+	    || (wc >= 0x3400 && wc <= 0x4DBF)     /* CJK ext A               */
+	    || (wc >= 0x4E00 && wc <= 0x9FFF)     /* CJK unified             */
+	    || (wc >= 0xA000 && wc <= 0xA4CF)     /* Yi                      */
+	    || (wc >= 0xAC00 && wc <= 0xD7A3)     /* Hangul syllables        */
+	    || (wc >= 0xF900 && wc <= 0xFAFF)     /* CJK compat ideographs   */
+	    || (wc >= 0xFE30 && wc <= 0xFE6F)     /* CJK compat forms        */
+	    || (wc >= 0xFF00 && wc <= 0xFF60)     /* fullwidth forms         */
+	    || (wc >= 0xFFE0 && wc <= 0xFFE6);    /* fullwidth signs         */
+}
+
+/* memmem(3) is a GNU extension; nnn uses it to search the selection
+ * buffer, which contains embedded NULs. */
+void *win_memmem(const void *hay, size_t haylen, const void *ndl, size_t ndllen)
+{
+	if (!hay || !ndl || ndllen > haylen)
+		return NULL;
+
+	if (!ndllen)
+		return (void *)hay;
+
+	const unsigned char *h = (const unsigned char *)hay;
+	const unsigned char *n = (const unsigned char *)ndl;
+	const unsigned char *last = h + (haylen - ndllen);
+
+	for (const unsigned char *p = h; p <= last; ++p)
+		if (*p == *n && !memcmp(p, n, ndllen))
+			return (void *)p;
+
+	return NULL;
+}
+
+ssize_t win_getline(char **lineptr, size_t *n, FILE *stream)
+{
+	if (!lineptr || !n || !stream) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (!*lineptr || !*n) {
+		size_t cap = 128;
+		char  *buf = (char *)malloc(cap);
+
+		if (!buf) {
+			errno = ENOMEM;
+			return -1;
+		}
+		*lineptr = buf;
+		*n = cap;
+	}
+
+	size_t len = 0;
+	int    c;
+
+	while ((c = fgetc(stream)) != EOF) {
+		if (len + 2 > *n) {
+			size_t cap = *n * 2;
+			char  *buf = (char *)realloc(*lineptr, cap);
+
+			if (!buf) {
+				errno = ENOMEM;
+				return -1;
+			}
+			*lineptr = buf;
+			*n = cap;
+		}
+
+		(*lineptr)[len++] = (char)c;
+
+		if (c == '\n')
+			break;
+	}
+
+	if (!len && c == EOF)
+		return -1;
+
+	(*lineptr)[len] = '\0';
+	return (ssize_t)len;
+}
+
+/* wcswidth(3): display width of a wide string, or -1 if any character
+ * is non-printable. */
+int win_ffs(int v)
+{
+	if (!v)
+		return 0;
+
+	int pos = 1;
+
+	while (!(v & 1)) {
+		v = (int)((unsigned int)v >> 1);
+		++pos;
+	}
+
+	return pos;
+}
+
+int win_link(const char *oldpath, const char *newpath)
+{
+	wchar_t *wold = path_to_wide(oldpath);
+	wchar_t *wnew = path_to_wide(newpath);
+	int      ret = -1;
+
+	if (wold && wnew && CreateHardLinkW(wnew, wold, NULL))
+		ret = 0;
+	else
+		errno = EPERM;
+
+	free(wold);
+	free(wnew);
+	return ret;
+}
+
+/* Windows has no POSIX permission bits. The CRT honours only the
+ * user-write bit via _chmod, which is the one thing nnn's chmod toggle
+ * actually needs (read-only on/off).
+ * TODO(arm64): map the full mode to an ACL edit (S5, feature parity). */
+int win_fchmod(int fd, mode_t mode)
+{
+	HANDLE h = (HANDLE)_get_osfhandle(fd);
+
+	if (h == INVALID_HANDLE_VALUE) {
+		errno = EBADF;
+		return -1;
+	}
+
+	FILE_BASIC_INFO fbi;
+
+	if (!GetFileInformationByHandleEx(h, FileBasicInfo, &fbi, sizeof(fbi))) {
+		errno = EACCES;
+		return -1;
+	}
+
+	if (mode & 0200)
+		fbi.FileAttributes &= ~(DWORD)FILE_ATTRIBUTE_READONLY;
+	else
+		fbi.FileAttributes |= FILE_ATTRIBUTE_READONLY;
+
+	if (!fbi.FileAttributes)
+		fbi.FileAttributes = FILE_ATTRIBUTE_NORMAL;
+
+	/* Setting a time field to 0 means "do not change". */
+	fbi.CreationTime.QuadPart = 0;
+	fbi.LastAccessTime.QuadPart = 0;
+	fbi.LastWriteTime.QuadPart = 0;
+	fbi.ChangeTime.QuadPart = 0;
+
+	if (!SetFileInformationByHandle(h, FileBasicInfo, &fbi, sizeof(fbi))) {
+		errno = EACCES;
+		return -1;
+	}
+
+	return 0;
+}
+
+/* mingw provides localtime_s with the MSVC argument order (out, in),
+ * which is the reverse of POSIX localtime_r (in, out). */
+struct tm *win_localtime_r(const time_t *t, struct tm *out)
+{
+	if (!t || !out)
+		return NULL;
+
+	return localtime_s(out, t) ? NULL : out;
+}
+
+int win_wcwidth(wchar_t wc)
+{
+	if (wc == 0)
+		return 0;
+
+	if (wc < 32 || (wc >= 0x7F && wc < 0xA0))
+		return -1;
+
+	if (is_zero_width(wc))
+		return 0;
+
+	return is_wide(wc) ? 2 : 1;
+}
+
+int win_wcswidth(const wchar_t *s, size_t n)
+{
+	int total = 0;
+
+	if (!s)
+		return -1;
+
+	for (size_t i = 0; i < n && s[i]; ++i) {
+		int w = win_wcwidth(s[i]);
+
+		if (w < 0)
+			return -1;
+
+		total += w;
+	}
+	return total;
+}
+
+/* ================================================================== *
+ * Miscellaneous
+ * ================================================================== */
+
+long win_sysconf(int name)
+{
+	if (name == _SC_NPROCESSORS_ONLN) {
+		SYSTEM_INFO si;
+
+		GetSystemInfo(&si);
+		return (long)si.dwNumberOfProcessors;
+	}
+
+	errno = EINVAL;
+	return -1;
+}
+
+char *win_ctermid(char *s)
+{
+	static char buf[] = WIN_TTYNAME;
+
+	if (!s)
+		return buf;
+
+	strcpy(s, WIN_TTYNAME);
+	return s;
+}
+
+void win_console_init(void)
+{
+	/* UTF-8 in and out, so wide-character output reaches the console
+	 * intact regardless of the system code page. */
+	SetConsoleOutputCP(CP_UTF8);
+	SetConsoleCP(CP_UTF8);
+
+	/* Enable VT processing, which lets ncurses use its ordinary
+	 * terminfo path (TERM=ms-terminal) rather than the legacy
+	 * console driver. */
+	HANDLE out = GetStdHandle(STD_OUTPUT_HANDLE);
+	DWORD  mode = 0;
+
+	if (out != INVALID_HANDLE_VALUE && GetConsoleMode(out, &mode))
+		SetConsoleMode(out, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
+
+	HANDLE in = GetStdHandle(STD_INPUT_HANDLE);
+
+	if (in != INVALID_HANDLE_VALUE && GetConsoleMode(in, &mode)) {
+		mode |= ENABLE_VIRTUAL_TERMINAL_INPUT;
+		mode &= ~(DWORD)ENABLE_QUICK_EDIT_MODE;   /* else mouse input is swallowed */
+		mode |= ENABLE_EXTENDED_FLAGS | ENABLE_MOUSE_INPUT | ENABLE_WINDOW_INPUT;
+		SetConsoleMode(in, mode);
+	}
+}
+
+/* ================================================================== *
+ * Directory change notification (ReadDirectoryChangesW)
+ *
+ * A fourth arm for nnn's LINUX_INOTIFY / BSD_KQUEUE / HAIKU_NM
+ * abstraction. Overlapped I/O is used so that polling never blocks the
+ * UI thread.
+ * ================================================================== */
+
+struct win_nm_t {
+	HANDLE     dir;
+	OVERLAPPED ov;
+	int        pending;
+	char       buf[8192];
+};
+
+win_nm_h win_init_nm(void)
+{
+	struct win_nm_t *h = (struct win_nm_t *)calloc(1, sizeof(*h));
+
+	if (!h)
+		return NULL;
+
+	h->dir = INVALID_HANDLE_VALUE;
+	h->ov.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL);
+
+	if (!h->ov.hEvent) {
+		free(h);
+		return NULL;
+	}
+	return h;
+}
+
+void win_close_nm(win_nm_h h)
+{
+	if (!h)
+		return;
+
+	win_stop_watch(h);
+
+	if (h->ov.hEvent)
+		CloseHandle(h->ov.hEvent);
+
+	free(h);
+}
+
+static int queue_read(struct win_nm_t *h)
+{
+	ResetEvent(h->ov.hEvent);
+
+	BOOL ok = ReadDirectoryChangesW(h->dir, h->buf, sizeof(h->buf), FALSE,
+					FILE_NOTIFY_CHANGE_FILE_NAME
+					| FILE_NOTIFY_CHANGE_DIR_NAME
+					| FILE_NOTIFY_CHANGE_ATTRIBUTES
+					| FILE_NOTIFY_CHANGE_SIZE
+					| FILE_NOTIFY_CHANGE_LAST_WRITE,
+					NULL, &h->ov, NULL);
+
+	h->pending = ok ? 1 : 0;
+	return ok ? 0 : -1;
+}
+
+int win_watch_dir(win_nm_h h, const char *path)
+{
+	if (!h || !path)
+		return -1;
+
+	win_stop_watch(h);
+
+	wchar_t *wpath = path_to_wide(path);
+
+	if (!wpath)
+		return -1;
+
+	h->dir = CreateFileW(wpath, FILE_LIST_DIRECTORY,
+			     FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+			     NULL, OPEN_EXISTING,
+			     FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OVERLAPPED, NULL);
+	free(wpath);
+
+	if (h->dir == INVALID_HANDLE_VALUE)
+		return -1;
+
+	return queue_read(h);
+}
+
+int win_stop_watch(win_nm_h h)
+{
+	if (!h)
+		return -1;
+
+	if (h->dir != INVALID_HANDLE_VALUE) {
+		CancelIo(h->dir);
+		CloseHandle(h->dir);
+		h->dir = INVALID_HANDLE_VALUE;
+	}
+
+	h->pending = 0;
+	return 0;
+}
+
+int win_is_update_needed(win_nm_h h)
+{
+	if (!h || h->dir == INVALID_HANDLE_VALUE || !h->pending)
+		return 0;
+
+	DWORD transferred = 0;
+
+	if (!GetOverlappedResult(h->dir, &h->ov, &transferred, FALSE))
+		return 0;   /* still pending, or failed */
+
+	/* Consume the notification and re-arm for the next one. */
+	queue_read(h);
+
+	return 1;
+}
+
+#endif /* _WIN32 */
