+#!/usr/bin/env bash
+#
+# Cross-build nnn.exe for native Windows ARM64 (classic ARM64, per ADR 0001).
+#
+# Host:   x86-64 Linux / WSL2
+# Target: aarch64-w64-mingw32  ->  IMAGE_FILE_MACHINE_ARM64 (0xAA64)
+#
+# Scope (v1, per S4 scope decision): core file manager only.
+#   Compiled out: readline, FIFO previews, X11, batch renamer, sessions,
+#                 user/group name lookup.
+#
+# Usage:  ./build-arm64.sh            # full build -> nnn.exe
+#         ./build-arm64.sh --compile  # compile only, no link (error triage)
+
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(cd "$HERE/../.." && pwd)"
+
+TC="$ROOT/toolchain/llvm-mingw/bin"
+SYSROOT="$ROOT/toolchain/sysroot-aarch64"
+CC="$TC/aarch64-w64-mingw32-clang"
+
+[ -x "$CC" ] || { echo "error: toolchain not found at $CC" >&2; exit 1; }
+[ -f "$SYSROOT/lib/libncursesw.a" ] || { echo "error: ncursesw not built" >&2; exit 1; }
+[ -f "$SYSROOT/lib/libpcre2-8.a" ] || { echo "error: pcre2 not built" >&2; exit 1; }
+
+# Feature scoping. Mirrors:
+#   make O_NOUG=1 O_NOFIFO=1 O_NORL=1 O_NOX11=1 O_NOBATCH=1 O_NOSSN=1 O_PCRE2=1
+CPPFLAGS=(
+	-DNORL -DNOUG -DNOFIFO -DNOX11 -DNOBATCH -DNOSSN
+	-DDIM_FILTERED
+	-DPCRE2 -DPCRE2_CODE_UNIT_WIDTH=8
+	-DPCRE2_STATIC
+	-DNCURSES_STATIC
+)
+
+CFLAGS=(
+	-std=c11 -O2
+	-Wall -Wextra -Wshadow
+	-Wno-unused-parameter
+)
+
+INCS=(
+	-I"$SYSROOT/include"
+	-I"$SYSROOT/include/ncursesw"
+)
+
+# ncurses' Windows build folds tinfo into libncursesw -- do NOT add -ltinfo.
+LIBS=(
+	-L"$SYSROOT/lib"
+	-lncursesw
+	-lpcre2-8
+	-lpthread
+	-lshlwapi
+	-luserenv
+)
+
+BUILD="$HERE/build-arm64"
+mkdir -p "$BUILD"
+
+SRCS=(src/nnn.c src/win/win_compat.c)
+
+if [ "${1:-}" = "--compile" ]; then
+	# Triage mode: report every error, not just the first 20.
+	for s in "${SRCS[@]}"; do
+		echo "CC $s"
+		"$CC" "${CFLAGS[@]}" "${CPPFLAGS[@]}" "${INCS[@]}" \
+			-ferror-limit=0 -c "$HERE/$s" -o "$BUILD/$(basename "$s" .c).o"
+	done
+	exit 0
+fi
+
+OBJS=()
+for s in "${SRCS[@]}"; do
+	o="$BUILD/$(basename "$s" .c).o"
+	echo "CC $s"
+	"$CC" "${CFLAGS[@]}" "${CPPFLAGS[@]}" "${INCS[@]}" -c "$HERE/$s" -o "$o"
+	OBJS+=("$o")
+done
+
+echo "LD nnn.exe"
+# -static avoids a libwinpthread-1.dll runtime dependency, so the result
+# is a single self-contained .exe. ncurses and PCRE2 are already static.
+"$CC" -static "${OBJS[@]}" -o "$HERE/nnn.exe" "${LIBS[@]}"
+
+echo
+echo "=== architecture gate ==="
+"$TC/llvm-readobj" --file-headers "$HERE/nnn.exe" | grep -i machine
