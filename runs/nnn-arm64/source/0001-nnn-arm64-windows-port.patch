+/*
+ * win_compat.h — Win32 portability layer for nnn
+ *
+ * nnn is a POSIX program. This header supplies the POSIX surface that
+ * mingw-w64 / UCRT does not, so that src/nnn.c compiles for native
+ * Windows (including Windows on ARM64) with a minimal diff.
+ *
+ * Design rules:
+ *   1. Only ever reached under _WIN32. Every POSIX platform keeps its
+ *      original code path untouched.
+ *   2. Where the CRT already provides a symbol with POSIX semantics, do
+ *      nothing and let it through.
+ *   3. Where a POSIX name exists with different semantics or signature,
+ *      shadow it with a wrapper — the same trick mingw itself uses
+ *      (e.g. `#define stat _stat64`). Macro sparingly; each one is a
+ *      chance to break an unrelated identifier.
+ *
+ * Modelled on misc/haiku/haiku_interop.h, which is how upstream already
+ * onboards a non-POSIX platform.
+ */
+
+#ifndef NNN_WIN_COMPAT_H
+#define NNN_WIN_COMPAT_H
+
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#include <io.h>
+#include <process.h>
+#include <direct.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ------------------------------------------------------------------ *
+ * Types the CRT lacks
+ * ------------------------------------------------------------------ */
+
+typedef int64_t  blkcnt_t;
+typedef uint32_t uid_t;
+typedef uint32_t gid_t;
+typedef uint32_t nlink_t;
+
+/* ------------------------------------------------------------------ *
+ * File type bits
+ *
+ * Windows has no S_IFLNK. We synthesise one (0xA000 fits the CRT's
+ * 16-bit mode_t) and report it for reparse points.
+ * ------------------------------------------------------------------ */
+
+#ifndef S_IFLNK
+#define S_IFLNK  0xA000
+#endif
+#ifndef S_ISLNK
+#define S_ISLNK(m)  (((m) & S_IFMT) == S_IFLNK)
+#endif
+#ifndef S_ISSOCK
+#define S_ISSOCK(m) ((void)(m), 0)
+#endif
+#ifndef S_ISFIFO
+#define S_ISFIFO(m) (((m) & S_IFMT) == _S_IFIFO)
+#endif
+#ifndef S_ISBLK
+#define S_ISBLK(m)  ((void)(m), 0)
+#endif
+
+#ifndef S_IRWXU
+#define S_IRWXU 0000700
+#define S_IRUSR 0000400
+#define S_IWUSR 0000200
+#define S_IXUSR 0000100
+#endif
+#ifndef S_IRWXG
+#define S_IRWXG 0000070
+#define S_IRGRP 0000040
+#define S_IWGRP 0000020
+#define S_IXGRP 0000010
+#endif
+#ifndef S_IRWXO
+#define S_IRWXO 0000007
+#define S_IROTH 0000004
+#define S_IWOTH 0000002
+#define S_IXOTH 0000001
+#endif
+#ifndef S_ISUID
+#define S_ISUID 0004000
+#define S_ISGID 0002000
+#define S_ISVTX 0001000
+#endif
+#ifndef S_BLKSIZE
+#define S_BLKSIZE 512
+#endif
+
+/* ------------------------------------------------------------------ *
+ * struct stat
+ *
+ * The CRT's struct stat lacks st_blocks and cannot express symlinks.
+ * We define a POSIX-shaped one and shadow the name. `stat` is both a
+ * struct tag and a function, and one object-like macro covers both.
+ * ------------------------------------------------------------------ */
+
+struct win_stat {
+	uint64_t   st_dev;
+	uint64_t   st_ino;
+	uint32_t   st_mode;
+	nlink_t    st_nlink;
+	uid_t      st_uid;
+	gid_t      st_gid;
+	uint64_t   st_rdev;
+	int64_t    st_size;
+	blkcnt_t   st_blocks;    /* 512-byte units, as POSIX */
+	int64_t    st_blksize;
+	time_t     st_atime;
+	time_t     st_mtime;
+	time_t     st_ctime;
+	/* NTFS timestamps are 100ns resolution; nnn uses nsec to break
+	 * sort ties, so carry the sub-second part rather than zeroing it. */
+	uint32_t   st_atime_nsec;
+	uint32_t   st_mtime_nsec;
+	uint32_t   st_ctime_nsec;
+};
+
+int win_stat(const char *path, struct win_stat *sb);
+int win_lstat(const char *path, struct win_stat *sb);
+int win_fstat_fd(int fd, struct win_stat *sb);
+
+#ifndef AT_FDCWD
+#define AT_FDCWD (-100)
+#endif
+#ifndef AT_SYMLINK_NOFOLLOW
+#define AT_SYMLINK_NOFOLLOW 0x100
+#endif
+
+/* mingw has no *at() family. nnn only performs CWD-relative lookups
+ * plus AT_SYMLINK_NOFOLLOW, so resolve against the process CWD. */
+int win_fstatat(int dirfd, const char *path, struct win_stat *sb, int flags);
+
+#define stat    win_stat
+#define lstat   win_lstat
+#define fstat   win_fstat_fd
+#define fstatat win_fstatat
+
+/* ------------------------------------------------------------------ *
+ * dirent with d_type
+ *
+ * mingw ships a <dirent.h>, but its struct dirent has no d_type, which
+ * would force a stat() per entry — the exact cost nnn is built to
+ * avoid. We implement dirent over FindFirstFileW, which supplies the
+ * file attributes for free.
+ * ------------------------------------------------------------------ */
+
+#define DT_UNKNOWN 0
+#define DT_FIFO    1
+#define DT_CHR     2
+#define DT_DIR     4
+#define DT_BLK     6
+#define DT_REG     8
+#define DT_LNK    10
+#define DT_SOCK   12
+
+struct dirent {
+	uint64_t       d_ino;
+	unsigned char  d_type;
+	unsigned short d_reclen;
+	char           d_name[1024];   /* UTF-8 */
+};
+
+typedef struct win_DIR DIR;
+
+DIR           *opendir(const char *path);
+struct dirent *readdir(DIR *dirp);
+int            closedir(DIR *dirp);
+int            dirfd(DIR *dirp);
+
+/* ------------------------------------------------------------------ *
+ * statvfs
+ * ------------------------------------------------------------------ */
+
+struct statvfs {
+	unsigned long f_bsize;
+	unsigned long f_frsize;
+	uint64_t      f_blocks;
+	uint64_t      f_bfree;
+	uint64_t      f_bavail;
